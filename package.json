{
  "name": "@coded-design/null-invaders",
  "version": "0.2.0",
  "type": "module",
  "description": "Null Invaders: a tiny MIT-licensed DOM arcade game by coded.design",
  "license": "MIT",
  "author": "Chris Cooley",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/coded-dot-design/null-invaders.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "playground:build": "vite build --config vite.config.js",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "test:package": "tsc -p tsconfig.package.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/react": "19.3.0"
  }
}
